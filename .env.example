# data.gov.in provides the "Current Daily Price of Various Commodities from
# Various Markets (Mandi)" dataset for free. The value below is the public
# demo key data.gov.in publishes in its own docs — it works, but it is shared
# by everyone and rate-limited. Get your own free key at https://data.gov.in
# (Sign up -> My Account -> API Key) and put it here for reliable results.
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571

# Resource ID for the daily mandi price dataset on data.gov.in.
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# No key needed for weather (Open-Meteo) or routing (public OSRM demo
# server), both free. The OSRM demo server is rate-limited too; for heavy
# use, self-host OSRM or swap in a commercial routing API.
OSRM_BASE_URL=http://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Diesel price has no free live API in India. This is a fallback default
# (Rs./litre) used only when the frontend doesn't supply one and the
# per-state table in app/services/fuel.py doesn't have an entry.
DEFAULT_DIESEL_PRICE=92.0

REQUEST_TIMEOUT_SECONDS=12
